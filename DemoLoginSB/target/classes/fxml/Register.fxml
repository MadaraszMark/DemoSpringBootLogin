<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchPaneRegisterMain" prefHeight="700.0" prefWidth="500.0" stylesheets="@../css/Register.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.main.controller.RegisterController">

    <children>
        <VBox fx:id="VBoxMain" alignment="CENTER" spacing="15" style="-fx-padding: 40;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <Label fx:id="lblRegisterTitle" styleClass="title-label" text="Regisztráció" />
            
            <Label fx:id="lblRegisterUserName" text="Felhasználónév:" />
            <VBox fx:id="VBoxRegisterUserName" maxWidth="Infinity" VBox.vgrow="NEVER">
                <TextField fx:id="txtRegisterUserName" maxWidth="Infinity" prefHeight="40" styleClass="input-field" />
                <Label fx:id="lblRegisterUserNameResult" />
            </VBox>

            <Label fx:id="lblRegisterEmail" text="E-mail:" />
            <VBox fx:id="VBoxRegisterEmail" maxWidth="Infinity" VBox.vgrow="NEVER">
                <TextField fx:id="txtRegisterEmail" maxWidth="Infinity" prefHeight="40" styleClass="input-field" />
                <Label fx:id="lblRegisterEmailResult" />
            </VBox>

            <Label fx:id="lblRegisterPassword" text="Jelszó:" />
            <VBox fx:id="VBoxLoginPassword" maxWidth="Infinity" VBox.vgrow="NEVER">
                <PasswordField fx:id="pwdLoginPassword" maxWidth="Infinity" prefHeight="40" styleClass="input-field" />
                <Label fx:id="lblLoginPasswordStrengthResult" />
            </VBox>

            <Label fx:id="lblRegisterResult" />

            <Button fx:id="btnRegister" maxWidth="Infinity" onMouseClicked="#handleRegister" prefHeight="45" text="Regisztráció" />
            <Button fx:id="btnRegisterToLogin" maxWidth="Infinity" onMouseClicked="#onLoginBackLinkClicked" text="Visszalépés a bejelentkezéshez" />

        </VBox>
    </children>
</AnchorPane>
