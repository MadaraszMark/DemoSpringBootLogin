<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchPaneLoginMain" prefHeight="600.0" prefWidth="500.0" stylesheets="@../css/Login.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.main.controller.LoginController">

   <children>
      <VBox fx:id="VBoxMain" alignment="CENTER" spacing="15" style="-fx-padding: 40;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         
         <Label fx:id="lblLoginTitle" styleClass="title" text="Belépés">
            <VBox.margin>
               <Insets bottom="20.0" />
            </VBox.margin></Label>

         <Label fx:id="lblLoginUserName" text="Felhasználónév:">
            <VBox.margin>
               <Insets right="280.0" />
            </VBox.margin></Label>
         <VBox fx:id="VBoxLoginUserName">
            <TextField fx:id="txtLoginUserName" maxWidth="Infinity" prefHeight="40" styleClass="input-field" />
            <Label fx:id="lblLoginUserNameResult" />
         </VBox>

         <Label fx:id="lblLoginPassword" text="Jelszó:">
            <VBox.margin>
               <Insets right="360.0" />
            </VBox.margin></Label>
         <VBox fx:id="VBoxLoginPassword">
            <PasswordField fx:id="pwdLoginPassword" maxWidth="Infinity" prefHeight="40" styleClass="input-field" />
            <Label fx:id="lblLoginPasswordStrengthResult" />
         </VBox>

         <Label fx:id="lblLoginResult" />

         <Button fx:id="btnLogin" maxWidth="Infinity" onMouseClicked="#handleLogin" prefHeight="45" styleClass="login-button" text="Belépek" />

         <Button fx:id="btnLoginRegister" maxWidth="Infinity" onMouseClicked="#onRegisterLinkClicked" styleClass="link-button" text="Még nincs fiókod? Regisztrálj!" />
      </VBox>
   </children>
</AnchorPane>
